{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co-Pilot AI Scientist v3 Human Gate Log",
  "type": "object",
  "required": [
    "gate_id",
    "gate_type",
    "timestamp_utc",
    "research_task_id",
    "options",
    "human_decision",
    "rationale",
    "affected_artifacts",
    "downstream_budget",
    "follow_up_checks"
  ],
  "properties": {
    "gate_id": {
      "type": "string",
      "description": "Stable unique ID such as idea_gate_001."
    },
    "gate_type": {
      "type": "string",
      "enum": [
        "scientific_taste_prior",
        "evaluator_stress_test",
        "frontier_steering",
        "verifiable_micro_evolution",
        "claim_calibration",
        "idea_selection",
        "hypothesis_refinement",
        "evaluator_approval",
        "branch_selection",
        "program_search_escalation",
        "claim_audit"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "research_task_id": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option_id", "summary"],
        "properties": {
          "option_id": { "type": "string" },
          "summary": { "type": "string" },
          "score": { "type": ["number", "null"] },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risks": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "human_decision": {
      "type": "string",
      "description": "Selected option IDs or a concise free-text decision."
    },
    "rationale": {
      "type": "string"
    },
    "affected_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "downstream_budget": {
      "type": "object",
      "description": "Budget allocation after the gate, e.g. steps, dollars, GPU hours."
    },
    "attention_cost": {
      "type": "object",
      "description": "Optional human-attention cost record. Required for future matched-budget claims.",
      "properties": {
        "human_actor": {
          "type": ["string", "null"],
          "description": "Human role or anonymized identifier."
        },
        "interaction_mode": {
          "type": ["string", "null"],
          "enum": ["async_review", "live_review", "pair_programming", "posthoc_replay", null]
        },
        "prompted_at_utc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "decision_at_utc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "active_review_minutes": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "wall_clock_latency_minutes": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "options_reviewed": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "artifacts_reviewed_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "decision_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "taste_insight": {
      "type": "object",
      "description": "Optional scientific-taste audit record. This is a qualitative search prior, not a complete reward model.",
      "properties": {
        "rubric_version": {
          "type": "string"
        },
        "scores": {
          "type": "object",
          "properties": {
            "problem_depth": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
            "novelty_potential": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
            "mechanistic_value": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
            "failure_informativeness": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
            "benchmark_taste": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
            "claim_significance": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
            "risk_asymmetry": { "type": ["number", "null"], "minimum": 1, "maximum": 5 }
          }
        },
        "taste_insight_score": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "qualitative_rationale": {
          "type": "string"
        },
        "non_metric_factors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "follow_up_checks": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
