# Copy to .env on the machine that runs experiments. Never commit real keys.

# Primary text/code model backend. DeepSeek's API is OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional VLM backend for figure critique via Monica's OpenAI-compatible API.
MONICA_API_KEY=
MONICA_BASE_URL=https://openapi.monica.im/v1
MONICA_VLM_MODEL=gpt-4o

# Optional fallback if DeepSeek is not configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Alternative: keep secrets outside the repo and point to them with:
# export AI_RESEARCH_ENV_FILE=~/.config/ai_research_repro/.env
